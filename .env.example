# Database
DATABASE_URL="postgresql://belote:belote@localhost:5433/belote?schema=public"

# Auth (required in production — no insecure default)
JWT_SECRET="dev-only-change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
NODE_ENV="development"

# CORS (comma-separated origins; empty = reflect request origin)
CORS_ORIGINS="http://localhost:5173"

# House rake account (seed creates this user)
HOUSE_EMAIL="house@belot.local"
